# Copie para .env e preencha. Nunca commite o .env.
SUPABASE_URL=https://<seu-projeto>.supabase.co
# Chave pública do projeto: a publishable (sb_publishable_...) ou a anon legada.
# É a única chave usada pela interface; o RLS protege os dados de cada usuário.
SUPABASE_ANON_KEY=
# Usada apenas em scripts de administração/migração. NUNCA na camada de apresentação.
SUPABASE_SERVICE_ROLE_KEY=
LOG_LEVEL=INFO
